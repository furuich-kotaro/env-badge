{
  "name": "env-badge",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=24.10.0 <25"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@types/chrome": "^0.1.42",
    "@types/node": "^24.0.0",
    "@wxt-dev/auto-icons": "^1.0.2",
    "typescript": "~5.7.2",
    "vitest": "^2.1.8",
    "wxt": "^0.20.0"
  }
}
